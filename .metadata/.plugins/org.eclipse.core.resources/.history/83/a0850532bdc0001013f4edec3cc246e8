package GestionDeNotas;

import java.awt.EventQueue;

import javax.swing.JFrame;
import javax.swing.JPanel;
import javax.swing.border.EmptyBorder;
import javax.swing.JScrollPane;
import javax.swing.AbstractAction;
import javax.swing.DefaultListModel;
import javax.swing.JButton;
import javax.swing.JList;
import javax.swing.JOptionPane;
import javax.swing.JTextArea;
import javax.swing.KeyStroke;
import javax.swing.SwingUtilities;
import javax.swing.UIManager;

import java.awt.event.ActionListener;
import java.awt.event.KeyEvent;
import java.util.ArrayList;
import java.awt.event.ActionEvent;
import javax.swing.undo.UndoManager;
import javax.swing.event.UndoableEditListener;
import javax.swing.event.UndoableEditEvent;

public class App extends JFrame {
	private UndoManager undoManager = new UndoManager();
	private static final long serialVersionUID = 1L;
	private JPanel contentPane;
	private DefaultListModel<String> modelo = new DefaultListModel<>();
	JList<String> list = new JList<>(modelo);
	ArrayList<String> notas = new ArrayList<>();	
	/**
	 * Launch the application.
	 */
	public static void main(String[] args) {
		 try {
		        UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
		    } catch (Exception e) {
		        e.printStackTrace();
		    }
		EventQueue.invokeLater(new Runnable() {
			public void run() {
				try {
					App frame = new App();
					frame.setVisible(true);
				} catch (Exception e) {
					e.printStackTrace();
				}
			}
		});
	}

	/**
	 * Create the frame.
	 */
	public App() {
		try {
            if (UIManager.getLookAndFeel().getName().equals("Metal")) {
                UIManager.setLookAndFeel("javax.swing.plaf.nimbus.NimbusLookAndFeel");
            } else {
                UIManager.setLookAndFeel(UIManager.getCrossPlatformLookAndFeelClassName());
            }
            SwingUtilities.updateComponentTreeUI(contentPane);
        } catch (Exception ex) {
            ex.printStackTrace();
        }
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setBounds(100, 100, 790, 512);
		setLocationRelativeTo(null);     
		contentPane = new JPanel();
		contentPane.setBorder(new EmptyBorder(5, 5, 5, 5));

		setContentPane(contentPane);
		contentPane.setLayout(null);
		
		JScrollPane scrollPane = new JScrollPane();
		scrollPane.setBounds(175, 11, 589, 423);
		contentPane.add(scrollPane);
		
		JTextArea textArea = new JTextArea();
		textArea.getDocument().addUndoableEditListener(new UndoableEditListener() {
		    public void undoableEditHappened(UndoableEditEvent e) {
		        undoManager.addEdit(e.getEdit());
		    }
		});
		scrollPane.setViewportView(textArea);
		
		JScrollPane scrollPane_1 = new JScrollPane();
		scrollPane_1.setBounds(10, 11, 155, 423);
		contentPane.add(scrollPane_1);
		
		scrollPane_1.setViewportView(list);
		JButton btnAgregar = new JButton("Agregar");
		
		btnAgregar.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				
		        String nombreNota = JOptionPane.showInputDialog(null, "Nombre de la Nota:");
		        if (nombreNota != null && !nombreNota.trim().isEmpty()) {
		            String contenido = textArea.getText().trim();
		            notas.add(contenido);
		            modelo.addElement(nombreNota);
		            textArea.setText("");
		        } else {
		            JOptionPane.showMessageDialog(null, "No se ingresó un nombre para la nota.", "Aviso", JOptionPane.WARNING_MESSAGE);
		        }
		    }
		});
		list.addListSelectionListener(new javax.swing.event.ListSelectionListener() {
		    public void valueChanged(javax.swing.event.ListSelectionEvent e) {
		        if (!e.getValueIsAdjusting()) {
		            int indice = list.getSelectedIndex();
		            if (indice != -1) {
		                String contenido = notas.get(indice);
		                textArea.setText(contenido);         
		            }
		        }
		    }
		});
		btnAgregar.setBounds(185, 439, 89, 23);
		contentPane.add(btnAgregar);
		
		JButton btnRehacer = new JButton("Rehacer");
		btnRehacer.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				 if (undoManager.canRedo()) {
			         undoManager.redo();
			     }
			}
		});
		btnRehacer.setBounds(383, 439, 89, 23);
		btnRehacer.setMnemonic(KeyEvent.VK_Z);
		contentPane.add(btnRehacer);
		
		JButton btnDeshacer = new JButton("Deshacer");
		btnDeshacer.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				 if (undoManager.canUndo()) {
					 undoManager.undo();
			     }
			}
		});
		btnDeshacer.setBounds(482, 439, 89, 23);
		contentPane.add(btnDeshacer);
		
		
		textArea.getInputMap().put(KeyStroke.getKeyStroke("control Z"), "deshacer");
		textArea.getActionMap().put("deshacer", new AbstractAction() {
		    public void actionPerformed(ActionEvent e) {
		        btnDeshacer.doClick(); 
		    }
		});
		
		textArea.getInputMap().put(KeyStroke.getKeyStroke("control Y"), "rehacer");
		textArea.getActionMap().put("rehacer", new AbstractAction() {
		    public void actionPerformed(ActionEvent e) {
		        btnRehacer.doClick(); 
		    }
		});
		
		JButton btnNuevo = new JButton("Nuevo");
		btnNuevo.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				textArea.setText("");
			}
		});
		btnNuevo.setBounds(284, 439, 89, 23);
		contentPane.add(btnNuevo);
		
		JButton btnSalir = new JButton("Salir");
		btnSalir.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				System.exit(0);
			}
		});
		btnSalir.setBounds(675, 439, 89, 23);
		contentPane.add(btnSalir);
		btnNuevo.setToolTipText("Nueva nota");
		btnAgregar.setToolTipText("Agregar una nueva nota con el contenido del area de texto");
		btnDeshacer.setToolTipText("Deshacer el ultimo cambio en el area de texto (Ctrl+Z)");
		btnRehacer.setToolTipText("Rehacer el último cambio deshecho en el area de texto (Ctrl+Y)");
		textArea.setToolTipText("Escribe aqui el contenido de la nota");
		list.setToolTipText("Lista de notas guardadas. Selecciona una para ver su contenido");
		btnSalir.setToolTipText("Salir de la aplicación");
		
	}
}
