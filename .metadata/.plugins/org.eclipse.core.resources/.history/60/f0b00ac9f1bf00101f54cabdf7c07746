public class Main implements Runnable{
	private static Cajero cajero;
	public static void main(String[] args) {
		int atendido = 0;
		for(int i = 1; i <= 2; i++) {
			atendido++;
			Thread cliente = new Thread(cajero = new Cajero(atendido));
			try {
				cliente.start();
				cliente.join();
				cliente.run();
			} catch (InterruptedException e) {
				System.out.println(e);
			}
		}
	}
	public void run() {
		System.out.println("El Cajero ha atendido a " + cajero.getAtendido());
		try {
			Thread.sleep(4000);
		} catch (InterruptedException e) {
			System.out.println(e);
		}
	}
}
