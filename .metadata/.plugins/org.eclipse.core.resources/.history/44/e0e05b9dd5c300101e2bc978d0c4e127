package ThreadsSuperMercado;

public class Main {
	public static void main(String[] args) {
		Caja caja = null;
		for(int i = 1; i <= numeroCliente();i++) {
			Thread cliente = new Thread(new Cliente(caja = new Caja(cajaRandom()),pagoCliente()));
			try {
				cliente.start();
				cliente.join();
				cliente.run();
				Thread.sleep(tiempo());
			} catch (InterruptedException e) {
				System.out.println(e);
			}
		}
		System.out.println(caja.getTotal());
	}
	public static int cajaRandom() {
		int numero = (int) (Math.random()*(1-1+1)+1);
		return numero;
	}
	public static int numeroCliente() {
		int numero = (int) (Math.random()*(20-1+1)+1);
		return numero;
	}
	public static double pagoCliente() {
		double numero = (double) (Math.random()*(300-1+1)+1);
		return numero;
	}
	public static int tiempo() {
		int numero = (int) (Math.random()*(3000-500+1)+500);
		return numero;
	}
}
