package ThreadsSuperMercado;

public class Main {
    public static void main(String[] args) {
        
        // Crear UNA sola caja
        Caja caja = new Caja(cajaRandom());

        int clientes = numeroCliente();
        Thread[] hilos = new Thread[clientes];

        for (int i = 0; i < clientes; i++) {
            Cliente cliente = new Cliente(caja, pagoCliente());
            hilos[i] = new Thread(cliente);
            hilos[i].start();

            try {
                Thread.sleep(tiempo());
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }

        // Esperar que todos los clientes terminen
        for (Thread t : hilos) {
            try {
                t.join();
            } catch (InterruptedException e) {}
        }

        // Mostrar total final
        System.out.println("\nTOTAL RECAUDADO: " + caja.getTotal());
    }

    public static int cajaRandom() {
        return (int)(Math.random() * 3) + 1; // Cajas 1–3
    }
    public static int numeroCliente() {
        return (int)(Math.random() * 5) + 1; // 1–5 clientes
    }
    public static double pagoCliente() {
        return (Math.random() * 300) + 1; // 1–300 €
    }
    public static int tiempo() {
        return (int)(Math.random() * 2500) + 500;
    }
}
